# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/orbitiq

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Keycloak)
AUTH_SECRET=your-secret-here
AUTH_KEYCLOAK_ID=orbitiq
AUTH_KEYCLOAK_SECRET=your-client-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/orbitiq

# API Gateway
API_GATEWAY_PORT=4000

# AI Providers (optional, for later sprints)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
